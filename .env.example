# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO — Panadería Familiar
#  Copia este archivo a ".env" y completa los valores.
#  NUNCA subas ".env" a git.
# ============================================================

# --- Firebase Web (consola de Firebase > Configuración del proyecto) ---
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Sesión ---
# Tiempo máximo de inactividad antes de cerrar la sesión (minutos).
SESSION_TIMEOUT_MIN=25

# --- CORS: origenes permitidos para las Cloud Functions (separados por comas) ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Administradores (emails separados por comas) ---
ADMIN_EMAILS=admin@tu-dominio.com
