rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // EJEMPLO SEGURO — requiere Firebase Auth.
    // Reemplaza "YOUR_PROJECT.firebaseapp.com" por tu dominio real.
    // Esta versión NO debe desplegarse hasta que la app tenga login.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          "tu-correo@example.com"
        ];
    }

    match /ventas/{document} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /clientes/{document} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /gastos_inventario/{document} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /adelantos/{document} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Por defecto, todo lo demás queda bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
