# ============================================================
#  VARIABLES DE ENTORNO para las Cloud Functions.
#  ESTE ARCHIVO se genera automáticamente desde el .env raíz con:
#      npm run config
#  No lo edites a mano; este ejemplo es solo de referencia.
# ============================================================

# Emails con rol de administrador (separados por comas).
ADMIN_EMAILS=admin@tu-dominio.com

# Origenes permitidos por CORS (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
